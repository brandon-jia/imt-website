---
import '../styles/global.css';
import mathStyles from 'katex/dist/katex.min.css?url';
import { PARTICIPANT_PORTAL_OPEN } from '../lib/portalAccess';

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Free online math competitions and resources in proof, modeling, and higher mathematics.',
} = Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path === '/' ? '/' : path.replace(/\/+$/, ''), Astro.site);
const pageTitle = `${title} | Integrated Math`;
const noindex = Astro.props.noindex || ['/test-portal', '/account', '/404', '/portal', '/learn/diagnostic/session/', '/learn/diagnostic/report/'].some(prefix => path.startsWith(prefix));
const parents = path.startsWith('/competitions/') ? [{ href: '/competitions', label: 'Competitions' }, ...(path.startsWith('/competitions/fall-2026/') ? [{ href:'/competitions/fall-2026',label:'Fall 2026 archive' }] : [])]
  : path.startsWith('/learn/diagnostic') ? [{ href: '/learn', label: 'Learn' }, ...(path !== '/learn/diagnostic' ? [{ href: '/learn/diagnostic', label: 'Diagnostic' }] : [])]
  : path.startsWith('/test-portal/') ? [{ href: '/test-portal', label: 'Contest portal' }] : [];
const breadcrumbs = [{ href: '/', label: 'Home' }, ...parents, { href: path, label: title }];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': 'https://www.integratedmath.org/#organization', name: 'Integrated Mathematics', url: 'https://www.integratedmath.org', logo: 'https://www.integratedmath.org/bridge-icon.png', email: 'info@integratedmath.org' },
    { '@type': 'WebSite', '@id': 'https://www.integratedmath.org/#website', name: 'Integrated Math', url: 'https://www.integratedmath.org', publisher: { '@id': 'https://www.integratedmath.org/#organization' } },
    { '@type': 'WebPage', '@id': canonical.href, url: canonical.href, name: pageTitle, description, isPartOf: { '@id': 'https://www.integratedmath.org/#website' } },
    ...(path !== '/' && !noindex ? [{ '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.label, item: new URL(item.href, Astro.site).href })) }] : []),
  ],
};
const navItems = [
  ...(PARTICIPANT_PORTAL_OPEN ? [{ href: '/test-portal', label: 'Contest portal' }] : []),
  { href: '/competitions', label: 'Competitions' },
  { href: '/learn', label: 'Learn' },
  { href: '/sponsors', label: 'Sponsors' },
  { href: '/team', label: 'About' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#203d32" />
    {(path.startsWith('/test-portal/') || path.startsWith('/learn/diagnostic/session/') || path.startsWith('/learn/diagnostic/report/') || path === '/learn/diagnostic/how-it-works') && <link rel="stylesheet" href={mathStyles} />}
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="D9QIVtP_MgreLoXxoRklkcyIU3o-eUYsJkiqSdJh9A0" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Integrated Math" />
    <meta property="og:title" content={`${title} | Integrated Math`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.integratedmath.org/social-preview.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Integrated Math: Free online competitions in proof, modeling, and higher mathematics." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.integratedmath.org/social-preview.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>

  <body class="min-h-screen bg-brand-light text-brand-dark antialiased">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="announcement">
      <div class="site-container announcement-inner">
        <span><strong>Fall 2026:</strong> Results are now available.</span>
        <a href="/competitions/fall-2026">View the archive</a>
      </div>
    </div>

    <header class="site-header">
      <div class="site-container header-inner">
        <a href="/" class="wordmark" aria-label="Integrated Math home">
          <img src="/bridge-mark.webp" width="64" height="32" alt="" aria-hidden="true" />
          <span>Integrated Math</span>
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
          {navItems.map(item => (
            <a
              href={item.href}
              aria-current={path.startsWith(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          <a class="register-link" href="/register">Email updates</a>
        </nav>

        <button id="mobile-menu-btn" class="menu-button" type="button" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>

      <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile navigation" hidden>
        <div class="site-container">
          {navItems.map(item => <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
          <a href="/register">Email updates</a>
        </div>
      </nav>
    </header>

    <main id="main-content" tabindex="-1" data-section={path.startsWith('/competitions/') ? 'competition-detail' : undefined}>
      {path !== '/' && !path.startsWith('/test-portal/attempts/') && <nav class="breadcrumbs site-container" aria-label="Breadcrumb">
        <ol>{breadcrumbs.map((item, index) => <li>{index === breadcrumbs.length - 1 ? <span aria-current="page">{item.label}</span> : <a href={item.href}>{item.label}</a>}</li>)}</ol>
      </nav>}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-container footer-main">
        <div>
          <a href="/" class="footer-wordmark">Integrated Math</a>
          <p>Student-led. Globally minded. Bridging theory and application.</p>
        </div>
        <div class="footer-links">
          <a href="/competitions">Competitions</a>
          <a href="/learn">Learn</a>
          <a href="/sponsors">Sponsors</a>
          <a href="/team">Team &amp; contact</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/cookies">Cookies &amp; storage</a>
          <a href="mailto:info@integratedmath.org">info@integratedmath.org</a>
        </div>
      </div>
      <div class="site-container footer-bottom">
        <span>&copy; {new Date().getFullYear()} Integrated Mathematics</span>
        <a href="/register">Email updates</a>
      </div>
    </footer>

  </body>
</html>

<script>
  const menuButton = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function closeMenu(returnFocus = false) {
    if (!mobileMenu || !menuButton) return;
    mobileMenu.hidden = true;
    menuButton.setAttribute('aria-expanded', 'false');
    menuButton.setAttribute('aria-label', 'Open menu');
    if (returnFocus) menuButton.focus();
  }

  menuButton?.addEventListener('click', () => {
    if (!mobileMenu) return;
    const willOpen = mobileMenu.hidden;
    mobileMenu.hidden = !willOpen;
    menuButton.setAttribute('aria-expanded', String(willOpen));
    menuButton.setAttribute('aria-label', willOpen ? 'Close menu' : 'Open menu');
  });

  mobileMenu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => closeMenu()));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && mobileMenu && !mobileMenu.hidden) closeMenu(true);
  });
  window.matchMedia('(min-width: 981px)').addEventListener('change', event => { if (event.matches) closeMenu(); });
</script>

<style is:global>
  .skip-link {
    position: fixed;
    left: 1rem;
    top: 1rem;
    z-index: 200;
    padding: 0.75rem 1rem;
    background: white;
    color: var(--ink);
    transform: translateY(-160%);
  }

  .skip-link:focus { transform: translateY(0); }

  .announcement {
    background: var(--green);
    color: white;
    font-size: 0.78rem;
  }

  .announcement-inner {
    min-height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem 1.25rem;
    text-align: center;
  }

  .announcement a {
    color: white;
    font-weight: 750;
    white-space: nowrap;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .header-inner {
    display: flex;
    min-height: 4.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .wordmark img { width: auto; height: 1.65rem; }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.7rem;
  }

  .desktop-nav a {
    color: #4f5b6d;
    font-size: 0.84rem;
    font-weight: 650;
    text-decoration: none;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] { color: var(--green); }

  .desktop-nav .register-link {
    border-left: 1px solid var(--line);
    padding: 0.4rem 0 0.4rem 1rem;
    color: var(--ink);
  }

  .menu-button {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: transparent;
    padding: 0.7rem;
  }

  .menu-button span {
    display: block;
    height: 1px;
    margin: 0.32rem 0;
    background: var(--ink);
  }

  .mobile-nav {
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .mobile-nav[hidden] { display: none; }
  .mobile-nav div { padding-block: 0.6rem 1rem; }
  .mobile-nav a {
    display: block;
    border-bottom: 1px solid var(--soft-line);
    padding: 0.85rem 0;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 650;
    text-decoration: none;
  }

  .site-footer {
    border-top: 1px solid #2d3934;
    background: var(--ink);
    color: #c9d0cc;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3rem;
    padding-block: 3.5rem 2.5rem;
  }

  .footer-wordmark {
    color: white;
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 650;
    text-decoration: none;
  }

  .footer-main p {
    max-width: 430px;
    margin: 0.8rem 0 0;
    color: #9aa4b3;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, auto);
    align-content: start;
    gap: 0.7rem 2rem;
  }

  .footer-links a,
  .footer-bottom a {
    color: #c9d0cc;
    font-size: 0.82rem;
    text-decoration: none;
  }

  .footer-links a:hover,
  .footer-bottom a:hover { color: white; text-decoration: underline; }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid #303b36;
    padding-block: 1rem;
    color: #bac6bf;
    font-size: 0.75rem;
  }

  @media (max-width: 980px) {
    .desktop-nav { display: none; }
    .menu-button { display: block; }
    .footer-main { grid-template-columns: 1fr; }
  }

  @media (max-width: 620px) {
    .announcement-inner { justify-content: flex-start; text-align: left; flex-wrap: wrap; padding-block: 0.6rem; gap: 0.3rem; }
    .announcement-inner strong { display: block; }
    .footer-links { grid-template-columns: 1fr; }
    .footer-bottom { align-items: flex-start; flex-direction: column; }
  }
</style>
