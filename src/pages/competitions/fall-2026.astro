---
import Layout from '../../layouts/Layout.astro';
import archive from '../../data/fall2026Archive.json';
const resources: { title: string; problems: string | null; solutions: string | null }[] = archive.resources;
const statistics: string | null = archive.statistics;
const placements = [{ title:'Overall Top Scorers',names:archive.overall },...archive.rounds.map(round=>({ title:`${round.title} Top Scorers`,names:round.topScorers }))];
---

<Layout title="Fall 2026 Results and Archive" description="Official Fall 2026 IMT placements, honorable mentions, and participating countries. 440+ registered competitors from 57+ countries.">
  <section class="bg-brand-dark text-brand-light border-b-4 border-brand-green">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10 pt-10 pb-16">
      <a href="/competitions" class="inline-flex items-center text-slate-400 hover:text-brand-gold transition-colors duration-150 text-sm font-medium mb-10 group">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Tournament Directory
      </a>
      <h1 class="font-serif font-bold text-4xl md:text-5xl lg:text-6xl leading-[1.1] tracking-tight mb-4 max-w-3xl">Fall 2026 Integrated<br /><span class="text-brand-dark">Mathematics Tournament</span></h1>
      <p class="text-slate-400 max-w-xl text-base font-light leading-relaxed">Results from the Fall 2026 Integrated Mathematics Tournament.</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-1.5 text-sm text-slate-500 font-medium mt-6 pt-5 border-t border-slate-700/40">
        <span><time datetime="2026-09-26">September 26</time> to <time datetime="2026-10-17">October 17, 2026</time></span><span class="text-slate-700" aria-hidden="true">·</span>
        <span>{archive.registeredCompetitors}+ Registered Competitors</span><span class="text-slate-700" aria-hidden="true">·</span>
        <span>{archive.countryCount}+ Countries</span><span class="text-slate-700" aria-hidden="true">·</span>
        <span>{archive.rounds.length} Rounds</span><span class="text-slate-700" aria-hidden="true">·</span><span>Online</span>
        <a class="underline underline-offset-4" href="/competitions/fall-2026/rules">Format and rules</a>
      </div>
    </div>
  </section>
  <section id="global-reach" class="py-20 bg-white border-b border-gray-200 overflow-hidden" aria-labelledby="reach-heading">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10">
      <div class="text-center mb-10"><h2 id="reach-heading" class="font-serif font-bold text-3xl text-brand-dark mb-2">Global Reach</h2><p class="text-slate-500 text-base max-w-lg mx-auto">{archive.registeredCompetitors}+ registered competitors from {archive.countryCount}+ countries.</p></div>
      <div class="w-full max-w-5xl mx-auto bg-slate-50 rounded-xl border border-gray-200 shadow-inner relative overflow-hidden"><img src="/fall-2026-world-map.svg" width="900" height="375" loading="lazy" decoding="async" alt="World map highlighting the 57 countries represented in Fall 2026 IMT registration." class="w-full h-auto" /></div>
      <details class="mt-5 text-sm text-slate-600"><summary class="cursor-pointer font-semibold py-3">View the highlighted countries</summary><ol class="country-list">{archive.countries.map(country=><li>{country}</li>)}</ol></details>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-10 mt-10 pt-8 border-t border-gray-100">
        <div class="text-center"><div class="font-serif font-bold text-4xl text-brand-dark mb-1">{archive.registeredCompetitors}+</div><div class="text-[11px] font-bold uppercase tracking-widest text-slate-400">Registered Competitors</div></div>
        <div class="flex items-center gap-2 bg-brand-light border border-gray-200 rounded-full px-5 py-2.5 text-sm font-semibold text-brand-dark shadow-sm"><span class="w-2 h-2 rounded-full bg-brand-green" aria-hidden="true"></span>Participating regions</div>
        <div class="text-center"><div class="font-serif font-bold text-4xl text-brand-dark mb-1">{archive.countryCount}+</div><div class="text-[11px] font-bold uppercase tracking-widest text-slate-400">Countries</div></div>
      </div>
    </div>
  </section>
  <section id="results" class="py-20 bg-brand-light border-b border-gray-200" aria-labelledby="results-heading">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10">
      <div class="mb-12 border-l-4 border-brand-gold pl-5"><h2 id="results-heading" class="font-serif font-bold text-3xl text-brand-dark mb-1">Top Scorers</h2><p class="text-slate-500 text-sm">Overall placements and recognition in each round.</p></div>
      <div class="grid md:grid-cols-3 gap-8 mb-12">
        {placements.map((group,index)=><section class="min-w-0 bg-white border border-gray-200 p-8 rounded-xl shadow-sm" aria-labelledby={`placement-${index}-heading`}>
          <h3 id={`placement-${index}-heading`} class="text-sm font-bold text-brand-dark uppercase tracking-wider mb-5 pb-3 border-b border-gray-100">{group.title}</h3>
          <ol class="archive-placement-list space-y-4" aria-label={group.title}>{group.names.map((name,place)=><li class="flex items-start gap-3 pb-3 border-b border-gray-50 last:border-0 last:pb-0"><span class={`font-black text-sm w-4 text-right shrink-0 ${place===0?'text-brand-gold':'text-slate-300'}`} aria-hidden="true">{place+1}.</span><span class="font-semibold text-brand-dark">{name}</span></li>)}</ol>
        </section>)}
      </div>
      <div class="honorable-mentions"><h3 class="font-serif font-bold text-xl text-brand-dark mb-6 pb-3 border-b border-gray-200">Honorable Mentions</h3><div class="grid md:grid-cols-2 gap-5">
        {archive.rounds.map((round,index)=><section class="min-w-0 bg-white border border-gray-200 p-6 rounded-lg shadow-sm" aria-labelledby={`honorable-${index}-heading`}><h4 id={`honorable-${index}-heading`} class="text-[11px] font-bold text-brand-dark uppercase tracking-widest mb-3 pb-2 border-b border-gray-100">{round.title}</h4><ul class="space-y-2 text-sm font-medium text-brand-dark">{round.honorableMentions.map(name=><li>{name}</li>)}</ul></section>)}
      </div></div>
    </div>
  </section>
  <section id="resources" class="archive-section resources-section" aria-labelledby="resources-heading">
    <div class="site-container">
      <div class="archive-section-heading"><h2 id="resources-heading">Resource Archive</h2><p>Problems and solutions will be added here.</p></div>
      <div class="archive-resource-grid">
        {resources.map(resource=><article class="archive-resource"><h3>{resource.title}</h3><div class="resource-files">
          {resource.problems?<a class="button-secondary" href={resource.problems} target="_blank" rel="noopener">Problems PDF</a>:<div class="pending-file"><span>Problems PDF</span><small>Not yet available</small></div>}
          {resource.solutions?<a class="button-primary" href={resource.solutions} target="_blank" rel="noopener">Solutions PDF</a>:<div class="pending-file"><span>Solutions PDF</span><small>Not yet available</small></div>}
        </div></article>)}
      </div>
      <div class="archive-statistics"><div><h3>Statistics Report</h3><p>Detailed score and problem statistics.</p></div>{statistics?<a class="button-secondary" href={statistics} target="_blank" rel="noopener">Download statistics PDF</a>:<span class="statistics-pending">Not yet available</span>}</div>
    </div>
  </section>
</Layout>
<style>
  [id] { scroll-margin-top:7rem; }
  .archive-section { padding-block:clamp(2.75rem,6vw,4.5rem); border-top:1px solid var(--line); }
  .archive-section-heading { margin-bottom:2rem; }
  .resources-section h2 { font-size:clamp(1.8rem,3vw,2.4rem); font-weight:750; line-height:1.2; letter-spacing:-.025em; }
  .archive-section-heading p { color:var(--muted); line-height:1.7; margin-top:.65rem; }
  .resources-section { background:white; }
  .country-list { columns:3; column-gap:2.5rem; padding-left:1.5rem; margin-top:.75rem; line-height:1.9; }
  .country-list li { break-inside:avoid; padding-left:.2rem; }
  .resources-section h3 { font-size:1.35rem; font-weight:700; line-height:1.4; }
  .archive-resource-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); border:1px solid var(--line); }
  .archive-resource { padding:1.5rem; min-width:0; }
  .archive-resource + .archive-resource { border-left:1px solid var(--line); }
  .archive-resource h3 { font-size:1.05rem; margin-bottom:1.25rem; }
  .resource-files { display:grid; gap:.75rem; }
  .pending-file { padding:.8rem 1rem; border:1px solid var(--line); background:var(--paper); }
  .pending-file span { display:block; font-weight:650; font-size:.9rem; }
  .pending-file small { display:block; color:var(--muted); font-size:.8rem; margin-top:.25rem; }
  .archive-statistics { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.5rem; padding-top:2rem; margin-top:2rem; border-top:1px solid var(--line); }
  .archive-statistics h3 { font-size:1.15rem; }
  .archive-statistics p { font-size:.9rem; color:var(--muted); line-height:1.7; margin-top:.35rem; }
  .statistics-pending { font-size:.85rem; color:var(--muted); border:1px solid var(--line); padding:.7rem 1rem; background:var(--paper); }
  @media(max-width:800px) { .archive-resource-grid { grid-template-columns:1fr; } .archive-resource + .archive-resource { border-left:0; border-top:1px solid var(--line); } .country-list { columns:2; } }
  @media(max-width:380px) { .country-list { columns:1; } }
</style>
