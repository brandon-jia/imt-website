---
import Layout from '../../../layouts/Layout.astro';
import FinalDemoToolbar from '../../../components/FinalDemoToolbar.astro';
---
<Layout title="Final Round Controls" description="Organizer controls and individual score breakdowns for the Fall 2026 final round.">
  <FinalDemoToolbar />
  <div class="site-container final-admin">
    <header class="admin-heading"><div><h1 class="page-title">Final round controls</h1></div><a class="text-link" href="/test-portal/admin">Back to test workspace</a></header>
    <p id="admin-final-status" class="control-message" role="status" aria-live="polite">Checking administrator access…</p>
    <section id="final-initialize" class="control-panel" hidden><h2>Prepare the final round</h2><p>Create a separate final with ten empty question slots. This does not modify qualifier tests, attempts, or results.</p><button id="initialize-final" type="button" class="button-primary">Create final-round draft</button></section>
    <div id="admin-final-content" hidden>
      <nav class="admin-sections" aria-label="Final round sections"><a href="#live-controls-title">Live controls</a><a href="#final-code-title">Access code</a><a href="#final-editor-title">Questions</a><a href="#final-scores-title">Scores</a></nav>
      <section class="control-panel" aria-labelledby="live-controls-title">
        <div class="panel-heading"><h2 id="live-controls-title">Live controls</h2><button class="button-secondary" id="refresh-final" type="button">Refresh</button></div>
        <dl class="control-stats"><div><dt>Status</dt><dd id="control-phase"></dd></div><div><dt>Current question</dt><dd id="control-question"></dd></div><div><dt>Time remaining</dt><dd id="control-timer">0:00</dd></div><div><dt>Joined individuals</dt><dd id="control-joined">0</dd></div><div><dt>Current solvers</dt><dd id="control-solved">0</dd></div></dl>
        <p id="control-help"></p><div class="control-actions"><button id="open-final-lobby" class="button-secondary" type="button">Open finalist access</button><button id="open-final-question" class="button-primary" type="button">Open question 1</button><button id="end-final-question" class="button-secondary" type="button">End question early</button><button id="finish-final" class="button-primary" type="button">Finish final round</button></div>
        <p class="privacy-note">Opening a question starts the same eight-minute window for everyone. Questions do not advance automatically. Scores are private to organizers; no tiebreaker or prize ranking is calculated.</p>
      </section>
      <section class="control-panel" aria-labelledby="final-code-title"><h2 id="final-code-title">Finalist access code</h2><p id="final-code-state"></p><form id="admin-code-form"><label for="admin-final-code">Shared code, 12–64 characters without spaces</label><div class="inline-controls"><input id="admin-final-code" class="form-control" type="password" minlength="12" maxlength="64" autocomplete="off" spellcheck="false" required /><button class="button-secondary" id="show-final-code" type="button" aria-controls="admin-final-code" aria-pressed="false">Show code</button><button class="button-secondary" type="submit">Set access code</button><button class="button-secondary" id="generate-final-code" type="button">Generate code</button></div></form><div id="new-final-code" class="new-code" hidden><p>New shared access code: <code id="issued-final-code"></code></p><button class="button-secondary" id="copy-final-code" type="button">Copy code</button><p id="copy-final-code-status" role="status" aria-live="polite"></p></div><p class="privacy-note">Codes are case-sensitive and stored as a hash. Copy a newly set code before leaving this page; the saved code cannot be displayed again. You can change it before or during the final. Changing it affects future joins; it does not remove people already admitted.</p></section>
      <section class="control-panel" aria-labelledby="final-editor-title"><div class="panel-heading"><h2 id="final-editor-title">Questions and answer keys</h2><span id="final-ready-count"></span></div><p>Save all ten questions and a code before opening access. You can edit a question until it opens. Opened questions and their answer keys stay locked.</p>
        <form id="final-question-editor"><label for="edit-final-number">Question</label><select id="edit-final-number" class="form-control">{Array.from({length:10},(_,i)=><option value={i+1}>Question {i+1}</option>)}</select><label for="edit-final-prompt">Problem statement (LaTeX supported)</label><textarea id="edit-final-prompt" class="form-control" rows="7" maxlength="20000" required></textarea><label for="edit-final-answer">Correct integer answer</label><input id="edit-final-answer" class="form-control" type="text" maxlength="102" autocomplete="off" spellcheck="false" required /><p id="final-editor-note" class="privacy-note"></p><button class="button-primary" type="submit" id="save-final-question">Save question</button></form>
        <button type="button" id="reload-final-question" class="button-secondary">Reload saved question</button>
        <details class="question-preview"><summary>Preview selected question</summary><div id="final-question-preview" class="portal-math"></div></details>
      </section>
      <section class="control-panel" aria-labelledby="final-scores-title"><div class="panel-heading"><h2 id="final-scores-title">Participant scores</h2><button id="export-final-scores" class="button-secondary" type="button">Download score breakdown CSV</button></div><p>Listed by name. Select a name for finish order, penalties, points, and submission history. Scroll the table to view every question. An asterisk marks an unsolved question with incorrect submissions.</p>
        <div class="score-scroll" tabindex="0" role="region" aria-label="All participant scores"><table class="scores-table"><caption class="sr-only">Participant totals and points for all ten final questions</caption><thead><tr><th scope="col">Participant</th><th scope="col">Total</th>{Array.from({length:10},(_,i)=><th scope="col">Q{i+1}</th>)}</tr></thead><tbody id="final-scores-body"></tbody></table></div>
        <label class="detail-label" for="final-detail-person">Participant breakdown</label><select id="final-detail-person" class="form-control"><option value="">Select a participant</option></select><div id="final-participant-detail"></div>
      </section>
      <details class="control-panel"><summary>Organizer action history</summary><ol id="final-event-log"></ol></details>
    </div>
    <dialog id="final-end-dialog"><h2 id="final-end-title">End this question early?</h2><p>Submissions will close immediately for everyone. This question cannot be reopened.</p><div class="control-actions"><button id="confirm-final-end" type="button" class="button-primary">End question</button><button id="cancel-final-end" type="button" class="button-secondary">Keep question open</button></div></dialog>
    <dialog id="final-discard-dialog" aria-labelledby="final-discard-title"><h2 id="final-discard-title">Discard unsaved changes?</h2><p>Your changes to this question have not been saved.</p><div class="control-actions"><button id="confirm-final-discard" type="button" class="button-secondary">Discard changes</button><button id="cancel-final-discard" type="button" class="button-primary">Keep editing</button></div></dialog>
  </div>
</Layout>
<style>
  .final-admin { max-width:1180px; padding-block:2.5rem 5rem; } .admin-heading { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-end; gap:1.5rem; margin-bottom:2rem; } .admin-heading .page-title { font-size:clamp(2.2rem,5vw,3.5rem); } .admin-heading .lede { margin-top:.8rem; }
  [hidden] { display:none !important; } .control-message { padding:1rem; border:1px solid var(--line); background:white; line-height:1.6; } .control-message:empty { display:none; }
  .admin-sections { display:flex; flex-wrap:wrap; gap:.75rem 1.5rem; padding-block:1rem; border-block:1px solid var(--line); } .admin-sections a { text-decoration:underline; text-underline-offset:4px; font-weight:650; } h2[id] { scroll-margin-top:7rem; }
  .control-panel { border-top:1px solid var(--line); padding-block:1.75rem; margin-top:1rem; } .control-panel p { line-height:1.7; margin-block:.8rem; } .control-panel h2 { font-size:1.4rem; font-weight:700; margin:0; } .panel-heading,.control-actions,.inline-controls { display:flex; align-items:center; flex-wrap:wrap; gap:.75rem; } .panel-heading { justify-content:space-between; }
  .control-stats { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); margin-block:1.4rem; border-block:1px solid var(--line); } .control-stats > div { padding:.8rem; } .control-stats dt { color:var(--muted); font-size:.8rem; } .control-stats dd { margin:.4rem 0 0; font-size:1.35rem; font-weight:700; font-variant-numeric:tabular-nums; }
  label { display:block; font-weight:650; margin-block:1rem .5rem; } .inline-controls input { flex:1; min-width:200px; } #edit-final-number { max-width:240px; } #edit-final-answer { max-width:340px; } .new-code { font:700 1.1rem monospace; overflow-wrap:anywhere; background:white; padding:1rem; border:1px solid var(--line); } .question-preview { margin-top:1.2rem; } summary { cursor:pointer; font-weight:700; } #final-question-preview { white-space:pre-wrap; line-height:1.8; padding-block:1rem; }
  .score-scroll { max-width:100%; overflow-x:auto; border:1px solid var(--line); background:white; margin-block:1.2rem; } .scores-table { width:100%; border-collapse:collapse; min-width:880px; font-size:.85rem; font-variant-numeric:tabular-nums; } .scores-table :global(th),.scores-table :global(td) { padding:.8rem .7rem; border-bottom:1px solid var(--line); text-align:left; } .scores-table th { background:#e9eee6; font-weight:700; } .scores-table :global(td:first-child) { max-width:230px; } .scores-table :global(button) { text-align:left; color:var(--green); text-decoration:underline; font-weight:650; } .scores-table :global(small) { display:block; color:var(--muted); margin-top:.3rem; }
  #final-detail-person { max-width:480px; } #final-participant-detail :global(table) { width:100%; border-collapse:collapse; margin-block:1rem; font-size:.85rem; } #final-participant-detail :global(th),#final-participant-detail :global(td) { padding:.6rem; border-bottom:1px solid var(--line); text-align:left; } #final-participant-detail :global(.detail-scroll) { overflow-x:auto; } #final-participant-detail :global(ol),#final-event-log { padding-left:1.3rem; font-size:.85rem; line-height:1.8; } #final-participant-detail :global(h3) { margin-top:1.5rem; font-weight:700; }
  dialog { max-width:500px; width:calc(100% - 2rem); border:1px solid var(--line); background:var(--paper); padding:2rem; color:var(--ink); } dialog::backdrop { background:#162b23b3; } dialog p { line-height:1.7; margin-block:1rem; }
  button:disabled { opacity:.5; } @media(max-width:650px){.control-stats { grid-template-columns:repeat(2,minmax(0,1fr)); } .inline-controls { align-items:stretch; flex-direction:column; } }
</style>
<script>
  import { finalRequest, finalClock, setupFinalDemoToolbar } from '../../../lib/liveFinalClient';
  import { escapeHtml, renderPortalMath, PortalClientError } from '../../../lib/testPortalClient';
  import type { AdminFinalState, FinalQuestion } from '../../../lib/liveFinalTypes';
  setupFinalDemoToolbar();
  const el=(id:string)=>document.getElementById(id)!;
  const status=el('admin-final-status'), editor=el('final-question-editor') as HTMLFormElement, number=el('edit-final-number') as HTMLSelectElement, prompt=el('edit-final-prompt') as HTMLTextAreaElement, answer=el('edit-final-answer') as HTMLInputElement;
  const detail=el('final-detail-person') as HTMLSelectElement, dialog=el('final-end-dialog') as HTMLDialogElement, discardDialog=el('final-discard-dialog') as HTMLDialogElement;
  let state:AdminFinalState|undefined, busy=false, dirty=false, editVersion=0, offset=0, lastStamp=0, lastSync=0, confirmationVersion=0, loadError=false, refreshing=false;
  let editorQuestion=1, pendingEditorQuestion:number|null=null, issuedCode='', issuedCodeEventId=0;
  const current=()=>state?.questions?.find(q=>q.number===state?.round?.current_question);
  const selectedLocked=()=>Number(number.value)<=(state?.round?.current_question??0);
  function active(q:FinalQuestion|undefined){return Boolean(q?.active&&q.closes_at&&Date.parse(q.closes_at)>Date.now()+offset);}
  function populateEditor(){const q=state?.questions?.find(q=>q.number===Number(number.value));if(!q)return;editorQuestion=q.number;prompt.value=q.prompt;answer.value=q.answer??'';editVersion=state!.round!.version;dirty=false;preview();}
  function editorNote(){el('final-editor-note').textContent=selectedLocked()?(dirty?'This question has opened and cannot be edited. Your unsaved text remains here until you discard it.':'This question has opened. Its text and answer key are locked.'):dirty?'Unsaved changes. Save this question before opening it.':'Saved question data. You can edit this question until it opens.';}
  function preview(){const box=el('final-question-preview');box.textContent=prompt.value;delete box.dataset.mathRendered;renderPortalMath(box.parentElement!);editorNote();}
  function requestEditorQuestion(next:number){if(dirty){pendingEditorQuestion=next;number.value=String(editorQuestion);discardDialog.showModal();return;}number.value=String(next);populateEditor();tick();}
  function render(next:AdminFinalState){
    const stamp=Date.parse(next.server_now);if(stamp<lastStamp)return;lastStamp=stamp;lastSync=Date.now();offset=stamp-Date.now();state=next;
    el('final-initialize').hidden=next.available;el('admin-final-content').hidden=!next.available;if(!next.available){status.textContent='No final round has been created yet.';return;}
    const round=next.round!,q=current();el('control-phase').textContent=round.status;el('control-question').textContent=`${round.current_question} / 10`;el('control-joined').textContent=String(next.participants?.length??0);el('control-solved').textContent=String(q?.solved_count??0);
    el('final-code-state').textContent=round.has_access_code?'An access code is set. Its saved value cannot be retrieved.':'No access code is set.';
    if(issuedCode&&next.events?.find(e=>e.action==='set_code')?.id!==issuedCodeEventId){issuedCode='';el('new-final-code').hidden=true;el('issued-final-code').textContent='';}
    const ready=next.questions?.filter(q=>q.prompt.trim()&&q.answer!==null&&q.answer!==undefined).length??0;el('final-ready-count').textContent=`${ready} / 10 ready`;
    for(const option of Array.from(number.options)){const question=next.questions?.find(q=>q.number===Number(option.value));const label=Number(option.value)<=round.current_question?'Locked':question?.prompt.trim()&&question.answer!==null&&question.answer!==undefined?'Ready':'Incomplete';option.textContent=`Question ${option.value} · ${label}`;}
    if(!dirty)populateEditor();
    el('control-help').textContent=round.status==='draft'?'Prepare every question and an access code, then open finalist access.':round.status==='lobby'?'Finalists can join. Open question 1 when everyone is ready.':round.status==='finished'?'Final complete. All scores and histories remain available below.':active(q)?`Question ${q?.number} is accepting answers.`:`Question ${round.current_question} is closed. ${round.current_question<10?'Open the next question when ready.':'Finish the round when ready.'}`;
    renderScores();tick();
  }
  function tick(){if(!state?.round)return;const r=state.round,q=current(),isActive=active(q),stale=Date.now()-lastSync>8000;el('control-timer').textContent=finalClock(q?.closes_at,offset);
    (el('open-final-lobby') as HTMLButtonElement).disabled=busy||stale||r.status!=='draft'||!r.has_access_code||state.questions?.some(q=>!q.prompt.trim()||q.answer===null||q.answer===undefined)||dirty;
    const open=el('open-final-question') as HTMLButtonElement;open.textContent=`Open question ${Math.min(10,r.current_question+1)}`;open.disabled=busy||stale||!['lobby','running'].includes(r.status)||isActive||r.current_question>=10||dirty;
    (el('end-final-question') as HTMLButtonElement).disabled=busy||stale||!isActive;(el('finish-final') as HTMLButtonElement).disabled=busy||stale||r.status!=='running'||r.current_question!==10||isActive;
    (el('generate-final-code') as HTMLButtonElement).disabled=busy||r.status==='finished';(el('admin-code-form') as HTMLFormElement).querySelectorAll<HTMLInputElement|HTMLButtonElement>('input,button').forEach(c=>c.disabled=busy||r.status==='finished');
    number.disabled=busy;editor.querySelectorAll<HTMLInputElement|HTMLTextAreaElement|HTMLButtonElement>('input,textarea,button').forEach(c=>c.disabled=busy||selectedLocked()||stale);(el('reload-final-question') as HTMLButtonElement).disabled=busy;editorNote();
  }
  function renderScores(){
    const participants=state?.participants??[];
    const rows=participants.length?participants.map(p=>`<tr><td><button type="button" data-participant="${escapeHtml(p.user_id)}">${escapeHtml(p.display_name)}</button><small>${escapeHtml(p.email)}</small></td><td><strong>${p.total_points}</strong></td>${Array.from({length:10},(_,i)=>{const s=p.scores.find(s=>s.question_number===i+1);return `<td>${s?s.points:'0'}${s?.solved_at?'':s?.incorrect_count?' *':''}</td>`;}).join('')}</tr>`).join(''):'<tr><td colspan="12">No individuals have joined yet.</td></tr>';
    const tbody=el('final-scores-body');if(tbody.dataset.rows!==rows){const focused=document.activeElement?.closest<HTMLButtonElement>('[data-participant]')?.dataset.participant;tbody.innerHTML=rows;tbody.dataset.rows=rows;if(focused)tbody.querySelector<HTMLButtonElement>(`[data-participant="${focused}"]`)?.focus();}
    const options=participants.map(p=>`<option value="${escapeHtml(p.user_id)}">${escapeHtml(p.display_name)} (${escapeHtml(p.email)})</option>`).join('');if(detail.dataset.options!==options){const selected=detail.value;detail.innerHTML='<option value="">Select a participant</option>'+options;detail.value=selected;detail.dataset.options=options;}
    renderDetail();el('final-event-log').innerHTML=(state?.events??[]).map(e=>`<li>${escapeHtml(new Date(e.created_at).toLocaleString())}: ${escapeHtml(e.action.replaceAll('_',' '))}${e.question_number?` · Q${e.question_number}`:''}</li>`).join('');
  }
  function renderDetail(){const target=el('final-participant-detail'),historyOpen=target.querySelector('details')?.open??false;const p=state?.participants?.find(p=>p.user_id===detail.value);const key=JSON.stringify(p??null);if(target.dataset.content===key)return;target.dataset.content=key;const html=p?`<h3>${escapeHtml(p.display_name)} · ${p.total_points} points</h3><div class="detail-scroll"><table><thead><tr><th>Question</th><th>Result</th><th>Correct order</th><th>Base</th><th>Wrong submissions</th><th>Penalty</th><th>Awarded</th></tr></thead><tbody>${Array.from({length:10},(_,i)=>{const s=p.scores.find(s=>s.question_number===i+1);return `<tr><th scope="row">Q${i+1}</th><td>${s?.solved_at?'Correct':s?.incorrect_count?'Unsolved':'No submission'}</td><td>${s?.finish_order??'–'}</td><td>${s?.base_points??0}</td><td>${s?.incorrect_count??0}</td><td>${2*(s?.incorrect_count??0)}</td><td>${s?.points??0}</td></tr>`;}).join('')}</tbody></table></div><details${historyOpen?' open':''}><summary>All submitted answers and timestamps</summary><ol>${p.submissions.length?p.submissions.map(s=>`<li>Q${s.question_number} · ${escapeHtml(new Date(s.accepted_at).toLocaleTimeString())} · Answer ${escapeHtml(s.answer)} · ${s.correct?'Correct':'Incorrect'} · ${s.points} points</li>`).join(''):'<li>No submissions yet.</li>'}</ol></details>`:'';if(target.dataset.html!==html){target.innerHTML=html;target.dataset.html=html;}}
  async function refresh(){if(refreshing)return;refreshing=true;try{const next=await finalRequest<AdminFinalState>(true);if(loadError||status.textContent==='Checking administrator access…')status.textContent='';loadError=false;render(next);}catch(error){loadError=true;status.textContent=error instanceof Error?error.message:'Could not load final-round controls.';}finally{refreshing=false;}}
  async function act(action:string,extra:Record<string,unknown>={},version=state?.round?.version){if(busy)return;busy=true;tick();
    try{const result=await finalRequest<{state:AdminFinalState;access_code?:string}>(true,{action,version,...extra});if(action==='save_question')dirty=false;else if(dirty&&editVersion===version)editVersion=result.state.round!.version;render(result.state);status.textContent=action==='save_question'?`Question ${extra.number} saved.`:action==='open_next'?`Question ${result.state.round?.current_question} is now open.`:action==='end_question'?'The question is now closed.':action==='set_code'?'The access code has been updated. Copy it below before leaving this page.':'Saved.';if(result.access_code){issuedCode=result.access_code;issuedCodeEventId=result.state.events?.find(e=>e.action==='set_code')?.id??0;el('new-final-code').hidden=false;el('issued-final-code').textContent=issuedCode;el('copy-final-code-status').textContent='';const codeInput=el('admin-final-code') as HTMLInputElement;codeInput.value='';codeInput.type='password';el('show-final-code').textContent='Show code';el('show-final-code').setAttribute('aria-pressed','false');}}
    catch(error){status.textContent=error instanceof PortalClientError&&error.code==='FINAL_STALE_CONTROL'&&action==='save_question'?'Another organizer changed the round. Your edits are still here. Copy them if needed, then use Reload saved question before saving again.':error instanceof Error?error.message:'Organizer action failed.';await refresh();}
    finally{busy=false;tick();}}
  el('initialize-final').addEventListener('click',()=>void act('initialize'));el('refresh-final').addEventListener('click',()=>void refresh());el('open-final-lobby').addEventListener('click',()=>void act('open_lobby'));el('open-final-question').addEventListener('click',()=>void act('open_next'));el('finish-final').addEventListener('click',()=>void act('finish'));
  el('end-final-question').addEventListener('click',()=>{confirmationVersion=state?.round?.version??0;el('final-end-title').textContent=`End question ${state?.round?.current_question} early?`;dialog.showModal();});el('cancel-final-end').addEventListener('click',()=>dialog.close());el('confirm-final-end').addEventListener('click',()=>{dialog.close();void act('end_question',{},confirmationVersion);});
  editor.addEventListener('submit',event=>{event.preventDefault();void act('save_question',{number:Number(number.value),prompt:prompt.value,answer:answer.value},editVersion);});number.addEventListener('change',()=>requestEditorQuestion(Number(number.value)));el('reload-final-question').addEventListener('click',()=>requestEditorQuestion(editorQuestion));prompt.addEventListener('input',()=>{dirty=true;preview();tick();});answer.addEventListener('input',()=>{dirty=true;preview();tick();});
  el('cancel-final-discard').addEventListener('click',()=>{pendingEditorQuestion=null;discardDialog.close();});el('confirm-final-discard').addEventListener('click',()=>{const next=pendingEditorQuestion;pendingEditorQuestion=null;discardDialog.close();if(next!==null){number.value=String(next);populateEditor();tick();}});
  window.addEventListener('beforeunload',event=>{if(dirty)event.preventDefault();});
  el('admin-code-form').addEventListener('submit',event=>{event.preventDefault();void act('set_code',{code:(el('admin-final-code') as HTMLInputElement).value});});el('generate-final-code').addEventListener('click',()=>void act('set_code',{generate:true}));
  el('show-final-code').addEventListener('click',()=>{const input=el('admin-final-code') as HTMLInputElement;input.type=input.type==='password'?'text':'password';el('show-final-code').textContent=input.type==='text'?'Hide code':'Show code';el('show-final-code').setAttribute('aria-pressed',String(input.type==='text'));});
  el('copy-final-code').addEventListener('click',async()=>{if(!issuedCode)return;try{await navigator.clipboard.writeText(issuedCode);el('copy-final-code-status').textContent='Code copied.';}catch{el('copy-final-code-status').textContent='Copy is unavailable. Select the code above and copy it manually.';}});
  el('final-scores-body').addEventListener('click',event=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-participant]');if(button){detail.value=button.dataset.participant!;renderDetail();detail.focus();}});detail.addEventListener('change',renderDetail);
  el('export-final-scores').addEventListener('click',()=>{
    const quote=(v:unknown)=>'"'+String(v??'').replace(/^[\s]*[=+@-]/,"'$&").replaceAll('"','""')+'"';
    const rows:unknown[][]=[['Name','Email','Total','Question','Result','Correct order','Base points','Wrong submissions','Penalty','Awarded points','Correct at']];
    for(const p of state?.participants??[])for(let n=1;n<=10;n++){const s=p.scores.find(s=>s.question_number===n);rows.push([p.display_name,p.email,p.total_points,n,s?.solved_at?'correct':s?.incorrect_count?'unsolved':'no submission',s?.finish_order,s?.base_points??0,s?.incorrect_count??0,2*(s?.incorrect_count??0),s?.points??0,s?.solved_at]);}
    const url=URL.createObjectURL(new Blob(['\uFEFF'+rows.map(r=>r.map(quote).join(',')).join('\r\n')],{type:'text/csv;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='imt-fall-2026-final-scores.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);
  });
  void refresh();window.setInterval(()=>void refresh(),2500);window.setInterval(tick,250);
</script>
